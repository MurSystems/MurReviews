# Supabase — Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Short link domain for /r/{token} and /o/{token} — currently the Workers dev
# address; swap in a custom short domain later.
LINK_DOMAIN=https://m.mursystems123.workers.dev

# Google Places API (New) — optional. Unset/blank disables review snapshots;
# the dashboard reports "Google review tracking not connected yet." instead.
GOOGLE_PLACES_API_KEY=

# sms_provider adapter (stage 9) — e.g. Mobile Message
SMS_PROVIDER=
SMS_PROVIDER_API_KEY=

# SMSGate (SMS Gateway for Android) — the operator/demo phone. Read only by
# scripts/gateway_setup.cjs; owners connect their own phone in Settings.
SMSGATE_DEMO_BASE_URL=https://api.sms-gate.app
SMSGATE_DEMO_USERNAME=
SMSGATE_DEMO_PASSWORD=
SMSGATE_DEMO_DEVICE_ID=

# Send guard (stage 5): in non-production, every sender except log_only
# refuses numbers not on this list (comma-separated E.164). Set PRODUCTION=true
# to disable the allowlist.
PRODUCTION=false
SEND_ALLOWLIST=
