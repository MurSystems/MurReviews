# Supabase — Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Short link domain for /r/{token} and /o/{token} (e.g. https://mur.reviews)
LINK_DOMAIN=

# Google Places API (New) — supplied before stage 7
GOOGLE_PLACES_API_KEY=

# sms_provider adapter (stage 9) — e.g. Mobile Message
SMS_PROVIDER=
SMS_PROVIDER_API_KEY=

# SMSGate (stage 5) — the demo/admin gateway phone credentials
SMSGATE_DEMO_BASE_URL=
SMSGATE_DEMO_API_KEY=

# Send guard (stage 5): in non-production, every sender except log_only
# refuses numbers not on this list (comma-separated E.164). Set PRODUCTION=true
# to disable the allowlist.
PRODUCTION=false
SEND_ALLOWLIST=
